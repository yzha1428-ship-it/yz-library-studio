# Copy this file to .env.local. Do not commit .env.local or any real credential.
#
# For a local-only run, set VITE_USE_FIREBASE_EMULATORS=true and use the demo
# project ID below. For a deployed project, set it to false and replace every
# Firebase value with the public Web App configuration from Firebase Console.
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-fit5032-efolio
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-fit5032-efolio.firebaseapp.com
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_FUNCTIONS_REGION=australia-southeast1
VITE_FUNCTIONS_EMULATOR_HOST=127.0.0.1
VITE_FUNCTIONS_EMULATOR_PORT=5001
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIRESTORE_EMULATOR_PORT=8080

# Obtain this from OpenWeatherMap for the assessed weather demonstration.
# The Weather page will show a setup error until this local-only value is set.
VITE_OPENWEATHER_API_KEY=
